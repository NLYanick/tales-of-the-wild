{
  "dialogs": [ 
    {
    	"text": "String",
    	"skip": false,
    	"item": 1, 
    	"interactive": true, 
    	"options": [	// Only if 'interactive' is true
    		"String",
    		"String",
    		"String"
    		// Maximum of 4, otherwise the rest won't show
    	]
    }, 
    {
    	"text": "String",
    	"skip": false,
    	"interactive": false, 
    	"option-chosen": 2	// Only if 'options' is used
    }
  ]
}


